# Backend: "mock" or "real"
BF_TRADING_BACKEND=mock

# Anthropic API
BF_ANTHROPIC_API_KEY=
BF_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Agent behavior
BF_STARTING_BALANCE=100.0
BF_EDGE_THRESHOLD=0.08
BF_SCAN_INTERVAL_SECONDS=300
BF_POSITION_REVIEW_INTERVAL_SECONDS=600
BF_MAX_POSITION_PCT=0.15
BF_MAX_OPEN_POSITIONS=10
BF_STOP_LOSS_PCT=0.50
BF_MAX_MARKETS_PER_SCAN=20
BF_MIN_MARKET_LIQUIDITY=5000.0
BF_MIN_MARKET_VOLUME=10000.0

# Real backend only (not needed for mock)
BF_POLYMARKET_PRIVATE_KEY=0x...
BF_POLYMARKET_FUNDER_ADDRESS=0x...
BF_POLYMARKET_SIGNATURE_TYPE=0
